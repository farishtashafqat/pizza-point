# Supabase project URL, e.g. https://project-ref.supabase.co
SUPABASE_URL=
# Used only to retrieve Supabase JWKS and profiles. Never put a service-role key in the frontend.
SUPABASE_ANON_KEY=
# Optional only when using a server-side Supabase client in future phases.
# Phase 4 uses the authenticated customer's token for its transactional RPC.
SUPABASE_SERVICE_ROLE_KEY=
# Backend-only Phase 6A provider key. Never expose this in frontend code/logs.
GROQ_API_KEY=
# Groq production model with JSON output and tool calling.
GROQ_MODEL=openai/gpt-oss-120b
# Shared secret for the read-only GET /assistant/menu n8n integration.
# Keep this backend-only; send it as the X-Assistant-Menu-Key request header.
ASSISTANT_MENU_API_KEY=
# Backend-only n8n production webhook and shared request secret.
N8N_CHAT_WEBHOOK_URL=http://127.0.0.1:5678/webhook/pizza-point-chat
N8N_WEBHOOK_SECRET=
